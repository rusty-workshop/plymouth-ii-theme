# "ii" Plymouth theme -- Material You style: flat surfaces, a rotating
# arc spinner (Material's indeterminate circular progress indicator),
# and a rounded icon badge. Colors pulled from the live generated
# palette at ~/.local/state/quickshell/user/generated/colors.json:
#   background            #131314
#   surface_container_high #292a2b (ring track / progress track)
#   primary               #bbc8d2 (spinner arc / progress fill)
#   primary_container     #3c4851 (icon badge)
#   on_primary_container  #d7e4ee (icon badge text)
#   surface_container     #1f2020 (dialog surface)
#   on_surface            #e4e2e3 (dialog text)

Window.SetBackgroundTopColor(0.0745, 0.0745, 0.0784);
Window.SetBackgroundBottomColor(0.0745, 0.0745, 0.0784);

tick = 0;
status = "normal";

# ---- Icon badge (rounded square container + "ii" mark), fades in once ----
badge_image = Image("icon_badge.png");
badge_sprite = Sprite(badge_image);
badge_x = Window.GetX() + Window.GetWidth() / 2 - badge_image.GetWidth() / 2;
badge_y = Window.GetY() + Window.GetHeight() * 0.36 - badge_image.GetHeight() / 2;
badge_sprite.SetPosition(badge_x, badge_y, 0);
badge_sprite.SetOpacity(0);

mark_raw = Image.Text("ii", 0.92, 0.92, 0.93);
mark_image = mark_raw.Scale(mark_raw.GetWidth() * 2.4, mark_raw.GetHeight() * 2.4);
mark_sprite = Sprite(mark_image);
mark_sprite.SetPosition(badge_x + badge_image.GetWidth() / 2 - mark_image.GetWidth() / 2, badge_y + badge_image.GetHeight() / 2 - mark_image.GetHeight() / 2, 1);
mark_sprite.SetOpacity(0);

# ---- Rotating arc spinner (Material indeterminate progress ring) ----
ring_track_image = Image("ring_track.png");
ring_track_sprite = Sprite(ring_track_image);
ring_center_x = Window.GetX() + Window.GetWidth() / 2;
ring_center_y = Window.GetY() + Window.GetHeight() * 0.62;
ring_track_sprite.SetPosition(ring_center_x - ring_track_image.GetWidth() / 2, ring_center_y - ring_track_image.GetHeight() / 2, 0);
ring_track_sprite.SetOpacity(0);

dot_image = Image("dot_primary.png");
dot_count = 28;
dot_radius = ring_track_image.GetWidth() / 2 - 6;
for (i = 0; i < dot_count; i++)
  {
    arc.item[i].angle = (2 * Math.Pi * i) / dot_count;
    arc.item[i].x = ring_center_x + dot_radius * Math.Cos(arc.item[i].angle) - dot_image.GetWidth() / 2;
    arc.item[i].y = ring_center_y + dot_radius * Math.Sin(arc.item[i].angle) - dot_image.GetHeight() / 2;
    arc.item[i].sprite = Sprite(dot_image);
    arc.item[i].sprite.SetPosition(arc.item[i].x, arc.item[i].y, 1);
    arc.item[i].sprite.SetOpacity(0);
  }

fun refresh_callback ()
  {
    tick++;

    if (status == "normal")
      {
        fade_in = tick / 30;
        if (fade_in > 1) fade_in = 1;

        badge_sprite.SetOpacity(fade_in);
        mark_sprite.SetOpacity(fade_in);
        ring_track_sprite.SetOpacity(fade_in * 0.6);

        leading_angle = tick * 0.09;
        for (i = 0; i < dot_count; i++)
          {
            edge = Math.Cos(arc.item[i].angle - leading_angle);
            intensity = Math.Max(0, edge);
            intensity = intensity * intensity * intensity * intensity;
            arc.item[i].sprite.SetOpacity(intensity * fade_in);
          }
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- Password dialog --------------------------------

fun dialog_setup ()
  {
    dialog.box_image = Image("dialog_box.png");
    dialog.box_sprite = Sprite(dialog.box_image);
    dialog.box_x = Window.GetX() + Window.GetWidth() / 2 - dialog.box_image.GetWidth() / 2;
    dialog.box_y = Window.GetY() + Window.GetHeight() * 0.72;
    dialog.box_sprite.SetPosition(dialog.box_x, dialog.box_y, 10);
    dialog.box_sprite.SetOpacity(0);

    dialog.prompt_sprite = Sprite();
    dialog.prompt_sprite.SetPosition(dialog.box_x + 24, dialog.box_y + 28, 11);

    dialog.bullets_sprite = Sprite();
    dialog.bullets_sprite.SetPosition(dialog.box_x + 24, dialog.box_y + 64, 11);
  }

dialog_setup();

fun display_normal_callback ()
  {
    global.status = "normal";
    dialog.box_sprite.SetOpacity(0);
    dialog.prompt_sprite.SetOpacity(0);
    dialog.bullets_sprite.SetOpacity(0);
  }

fun display_password_callback (prompt, bullets)
  {
    global.status = "password";

    dialog.box_sprite.SetOpacity(1);

    prompt_raw = Image.Text(prompt, 0.92, 0.92, 0.93);
    prompt_image = prompt_raw.Scale(prompt_raw.GetWidth() * 1.3, prompt_raw.GetHeight() * 1.3);
    dialog.prompt_sprite.SetImage(prompt_image);
    dialog.prompt_sprite.SetOpacity(1);

    bullet_string = "";
    for (i = 0; i < bullets; i++)
      {
        bullet_string = bullet_string + "* ";
      }
    bullets_image = Image.Text(bullet_string, 0.8, 0.8, 0.82);
    dialog.bullets_sprite.SetImage(bullets_image);
    dialog.bullets_sprite.SetOpacity(1);
  }

fun display_message_callback (message)
  {
    message_image = Image.Text(message, 0.65, 0.65, 0.67);
    message_sprite = Sprite(message_image);
    message_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - message_image.GetWidth() / 2, Window.GetY() + Window.GetHeight() * 0.9, 10);
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetMessageFunction(display_message_callback);

#----------------------------------------- Linear progress bar --------------------------------

progress_bg_image = Image("progress_bg.png");
progress_bg_sprite = Sprite(progress_bg_image);
progress_bg_x = Window.GetX() + Window.GetWidth() / 2 - progress_bg_image.GetWidth() / 2;
progress_bg_y = Window.GetY() + Window.GetHeight() * 0.85;
progress_bg_sprite.SetPosition(progress_bg_x, progress_bg_y, 0);

progress_fill_original = Image("progress_fill.png");
progress_fill_sprite = Sprite();
progress_fill_sprite.SetPosition(progress_bg_x, progress_bg_y, 1);

fun progress_callback (duration, progress)
  {
    fill_width = Math.Int(progress_fill_original.GetWidth() * progress);
    if (fill_width < 1)
      fill_width = 1;
    progress_fill_image = progress_fill_original.Scale(fill_width, progress_fill_original.GetHeight());
    progress_fill_sprite.SetImage(progress_fill_image);
  }

Plymouth.SetBootProgressFunction(progress_callback);

#----------------------------------------- Quit --------------------------------

fun quit_callback ()
  {
    badge_sprite.SetOpacity(0);
    mark_sprite.SetOpacity(0);
    ring_track_sprite.SetOpacity(0);
    for (i = 0; i < dot_count; i++)
      arc.item[i].sprite.SetOpacity(0);
    progress_bg_sprite.SetOpacity(0);
    progress_fill_sprite.SetOpacity(0);
  }

Plymouth.SetQuitFunction(quit_callback);
